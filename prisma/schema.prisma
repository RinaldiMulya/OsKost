// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Enums
// ============================================

enum UserRole {
  ADMIN
  TENANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  OVERDUE
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  MIDTRANS
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ============================================
// Models
// ============================================

model Property {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String
  rooms     Room[]
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phoneNumber  String?  @unique // Login Tenant (No HP = Username)
  passwordHash String
  role         UserRole @default(TENANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantProfile TenantProfile?
  leases        Lease[]
  panoramaImages PanoramaImage[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  discountClaims DiscountClaim[]
}

model TenantProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  ktpNumber        String?
  ktpPhotoUrl      String?
  address                String? // Alamat asal sesuai KTP
  emergencyContactName   String? // Hubungan / Nama kontak darurat
  emergencyContactNumber String? // Nomor kontak darurat
}

model Room {
  id          String     @id @default(cuid())
  number      String     @unique
  name        String
  price       Int
  status      RoomStatus @default(AVAILABLE)
  description String?    @db.Text
  facilities  String[]
  images      String[]
  panoramaImages PanoramaImage[]
  // tokenListrikId String?

  // Relasi ke Property
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  leases Lease[]

  @@unique([number, propertyId]) // Nomor kamar unik di dalam satu properti
}

model Lease {
  id        String    @id @default(cuid())
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)

  exitReason String? // Contoh: "Selesai kontrak" atau "Berhenti tengah jalan"

  userId String
  user   User   @relation(fields: [userId], references: [id])
  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  invoices Invoice[]
  reports  Report[]
}

model Invoice {
  id         String   @id @default(cuid())
  externalId String?  @unique // Kunci idempotensi: "INV-{leaseId}-{periode}" — mencegah invoice ganda
  dueDate    DateTime
  amount     Int // Total net yang harus dibayar tenant (dikirim ke Payment Gateway)

  rentAmount    Int @default(0)
  utilityAmount Int @default(0) // Listrik/Air
  otherAmount   Int @default(0) // Sampah/Keamanan

  // Rincian Biaya Admin Payment Gateway (Split Fee)
  totalAdminFee  Int @default(0) // Total fee PG (misal Rp 4.000)
  tenantAdminFee Int @default(0) // Porsi dibayar tenant (misal Rp 2.000)
  ownerAdminFee  Int @default(0) // Porsi diserap owner (misal Rp 2.000)

  // Diskon / Promo (Google Review, Early Bird, dll)
  discountAmount Int     @default(0) // Nominal diskon dalam Rupiah
  discountReason String? // Kode promo: "GOOGLE_REVIEW", "EARLY_BIRD", dll

  status    PaymentStatus   @default(UNPAID)
  provider  PaymentProvider @default(MANUAL)
  providerRef String?  // transaction_id dari Midtrans
  paymentUrl  String?  // Redirect URL Snap
  snapToken   String?  // Token Midtrans Snap
  paidAt      DateTime?
  expiredAt   DateTime?
  proofUrl    String?  // Bukti transfer manual (mode MANUAL)
  adminNote   String?  // Catatan admin jika ada potongan/denda

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id])

  webhookLogs WebhookLog[]
  discountClaims DiscountClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([leaseId])
}

model Report {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  photoUrl    String?
  status      ReportStatus @default(OPEN)

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PanoramaImage {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String   // URL publik dari Supabase (Oskost-Data-Public)
  storagePath String   // Path spesifik di bucket (untuk keperluan delete)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // BILLING, MAINTENANCE, SYSTEM, INFO
  isRead    Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================
// Payment Gateway Models
// ============================================

// Konfigurasi metode pembayaran (dinamis, bisa diubah Admin via Dashboard)
model PaymentMethod {
  id                  String   @id @default(cuid())
  methodCode          String   @unique // e.g., "QRIS", "BCA_VA", "MANDIRI_VA"
  methodName          String   // e.g., "QRIS", "BCA Virtual Account"
  feeType             String   // "PERCENTAGE" atau "FLAT"
  feeAmount           Int      // Dalam Rupiah (flat) atau basis poin (misal 30 = 0.3%)
  tenantFeePercentage Int      @default(50) // Porsi beban penyewa (50%)
  ownerFeePercentage  Int      @default(50) // Porsi beban owner (50%)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Audit trail webhook — bukti forensik saat ada sengketa/investigasi
model WebhookLog {
  id             String          @id @default(cuid())
  invoiceId      String?
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  provider       PaymentProvider
  rawPayload     Json
  signatureValid Boolean         @default(false)
  httpStatusSent Int?
  createdAt      DateTime        @default(now())

  @@index([provider, createdAt])
}

// Konfigurasi diskon/promo (pilihan dropdown di Admin Dashboard)
model DiscountPreset {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "GOOGLE_REVIEW", "EARLY_BIRD"
  label       String   // e.g., "Bebas Biaya Admin (Google Review)"
  description String?  // Keterangan tambahan
  type        String   // "FIXED" atau "ADMIN_FEE_WAIVER"
  amount      Int      @default(0) // Nominal diskon (jika FIXED), 0 jika ADMIN_FEE_WAIVER
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Pengajuan klaim diskon/promo oleh tenant (misal screenshot review Google Maps)
model DiscountClaim {
  id           String      @id @default(cuid())
  invoiceId    String
  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountCode String      // e.g. "GOOGLE_REVIEW"
  proofUrl     String      // URL foto screenshot ulasan di Supabase Storage
  googleName   String?     // Nama akun Google yang memberikan ulasan
  status       ClaimStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  @@index([status])
  @@index([invoiceId])
  @@index([userId])
}