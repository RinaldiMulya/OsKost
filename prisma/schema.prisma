// ==============================================================================
// 📋 OSKOST PRISMA SCHEMA V2.0 (DRAFT)
// Multi-Tenant B2B SaaS Platform + Native Mobile Sanctuary Alignment
// ==============================================================================


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================================================================
// 1. ENUMS (ROLE, STATUS, & SAAS TIERS)
// ==============================================================================

enum UserRole {
  SUPER_ADMIN     // [SaaS Pivot] Pengelola Platform OsKost (Akses oskost.id/super-admin)
  PROPERTY_OWNER  // [SaaS Pivot] Pemilik Kost B2B (Akses app.oskost.id)
  ADMIN           // Backward compatibility untuk admin Pulo Jahe saat ini
  MANAGER         // [SaaS & Device Guard] Pengelola Operasional / Penanggung Jawab Kost
  TENANT          // Penghuni Kamar (Akses Flutter Mobile via JWT)
}

enum SaaSPlanTier {
  FREE            // Kuota 1-5 Kamar (Gratis Selamanya)
  STARTER         // Kuota 6-15 Kamar (Rp 69.000/bln)
  GROWTH          // Kuota 16-40 Kamar (Rp 179.000/bln)
  PRO             // Kuota 41-100 Kamar (Rp 349.000/bln)
  ENTERPRISE      // Kuota > 100 Kamar (Custom / Rp 4.500/kamar)
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  OVERDUE
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  MIDTRANS
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ==============================================================================
// 2. SAAS MULTI-TENANCY & PROPERTY (WHITE-LABELING)
// ==============================================================================

model Property {
  id              String   @id @default(cuid())
  slug            String?  @unique @default("pulo-jahe") // Subdomain routing atau slug URL
  name            String   // Contoh: "Smartkost Pulo Jahe"
  address         String
  mapsLink        String?

  // [SaaS Pivot: Kepemilikan B2B]
  ownerId         String?
  owner           User?    @relation("PropertyOwner", fields: [ownerId], references: [id])

  // [SaaS Pivot & Flutter: Dynamic White-Label Theme]
  logoUrl         String?  // Logo kost untuk header mobile / web
  primaryColorHex String   @default("#8C6239") // Theme ColorScheme (Terracotta Wabi-Sabi default)
  accentColorHex  String   @default("#5D6654") // Koke Moss default
  features        Json?    // e.g. { "hasSmartLock": true, "hasSosButton": true }

  // [Mobile UI: EmergencyBottomSheet & Bantuan Pengelola]
  managerPhone    String?  // e.g. "087890976782" (Ibu Ayu - Pengelola)
  guardPhone      String?  // e.g. "08123456789" (Pak Slamet & Pak Yanto - Pos Jaga)
  emergencyPhone  String?  // Nomor darurat terdekat (Polsek/RS/Damkar)

  // [Pencairan Sewa Pemilik Kost & Tier Starter: Manual Transfer & QRIS Statis]
  bankName           String?  // e.g. "BCA", "MANDIRI", "BRI", "BNI"
  bankAccountNumber  String?  // e.g. "1234567890"
  bankAccountHolder  String?  // e.g. "Ahmad Rinaldi"
  bankAccountInfo    String?  // Petunjuk transfer / catatan manual (db.Text)
  qrisImageUrl       String?  // URL gambar QRIS Statis di Cloudinary

  // [Metode Pembayaran: Tier Pro (Direct Merchant Midtrans)]
  midtransMerchantId String?  // ID Merchant Midtrans Pemilik Kost
  midtransServerKey  String?  // AES-256-GCM Encrypted at rest (DILARANG Plaintext!)
  midtransClientKey  String?  // Public Client Key untuk SDK Frontend/Mobile
  isMidtransActive   Boolean  @default(false) // Toggle switch aktif/non-aktif

  // [SaaS Pivot: Status Langganan Platform]
  subscription    SaaSSubscription?

  // [Strict Data Isolation Relations]
  rooms           Room[]
  leases          Lease[]
  invoices        Invoice[]
  reports         Report[]
  notifications   Notification[]
  saasTransactions SaaSTransaction[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@index([slug])
}

model SaaSSubscription {
  id                     String             @id @default(cuid())
  propertyId             String             @unique
  property               Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  planTier               SaaSPlanTier       @default(STARTER)
  status                 SubscriptionStatus @default(ACTIVE)
  maxRooms               Int                @default(10) // Kuota kamar maksimal sesuai paket
  monthlyPrice           Int                @default(0)  // Nominal langganan SaaS (Rp)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  midtransSubscriptionId String?            // ID recurring billing dari Midtrans
  trialEndsAt            DateTime?
  cancelledAt            DateTime?
  suspendedAt            DateTime?
  notes                  String?
  transactions           SaaSTransaction[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
}

// ==============================================================================
// 3. USER MANAGEMENT & AUTHENTICATION
// ==============================================================================

model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  phoneNumber       String?   @unique // Login Tenant (No HP = Username)
  passwordHash      String
  role              UserRole  @default(TENANT)

  // [Mobile UI: ForceResetScreen & SecurityMenu]
  forceReset        Boolean   @default(false) // Wajib ganti password saat login perdana
  passwordChangedAt DateTime?                 // Metadata "Terakhir diperbarui X hari lalu"
  isActive          Boolean   @default(true)  // Kontrol akses akun aktif
  isSuspended       Boolean   @default(false) // Penangguhan akses aplikasi jika ada tunggakan
  lastLoginAt       DateTime?
  impersonatedBy    String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // [SaaS Pivot: Properti yang dimiliki (Jika role PROPERTY_OWNER)]
  ownedProperties   Property[] @relation("PropertyOwner")

  // Relasi Tenant & Operasional
  tenantProfile     TenantProfile?
  leases            Lease[]
  refreshTokens     RefreshToken[]        // [Mobile Auth: JWT Rotation]
  panoramaImages    PanoramaImage[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  discountClaims    DiscountClaim[]

  @@index([role])
}

// [Mobile Auth: JWT Dual-Auth Session & Refresh Token Rotation]
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime? // Jika diisi = token sudah direvoke / logout
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TenantProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName               String
  ktpNumber              String?
  ktpPhotoUrl            String?  // Bukti KTP di Supabase Private Bucket

  // [Mobile UI: PrimaryIdentityCard & ArsipVerifikasiCard]
  avatarUrl              String?  // Foto profil personal tenant
  isVerified             Boolean  @default(false) // Centang hijau "Tervalidasi / Verified"
  address                String?  // Alamat asal sesuai KTP
  emergencyContactName   String?  // Nama kontak darurat
  emergencyContactNumber String?  // Nomor kontak darurat
  emergencyContactRelation String? // e.g. "Keluarga / Kerabat Terdekat", "Ibu Kandung"
}

// ==============================================================================
// 4. ROOM & INVENTORY MANAGEMENT
// ==============================================================================

model Room {
  id             String          @id @default(cuid())
  number         String          // Nomor pintu kamar, e.g. "005"
  name           String          // Nama unit kamar, e.g. "VIP Suite", "Kamar 005"
  type           String?         // [Mobile UI: "Sanctuary Deluxe", "Standard Room"]
  price          Int
  status         RoomStatus      @default(AVAILABLE)
  description    String?         @db.Text
  facilities     String[]
  images         String[]
  panoramaImages PanoramaImage[]

  // [Strict Multi-Tenant Scoping]
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leases         Lease[]

  @@unique([number, propertyId]) // Nomor kamar unik di dalam 1 properti
  @@index([propertyId])
  @@index([status])
}

// ==============================================================================
// 5. LEASE & CONTRACT (ALUMNI ARCHITECTURE)
// ==============================================================================

model Lease {
  id              String    @id @default(cuid())
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean   @default(true)
  exitReason      String?   // Contoh: "Selesai kontrak", "Pindah kerja"

  // [Mobile UI: ArsipVerifikasiCard Dokumen Perjanjian Hunian]
  agreementDocUrl String?   // URL dokumen PDF surat perjanjian sewa di Supabase Storage

  // [Strict Multi-Tenant Scoping]
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id])

  userId          String
  user            User      @relation(fields: [userId], references: [id])
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id])

  invoices        Invoice[]
  reports         Report[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([roomId])
  @@index([isActive])
}

// ==============================================================================
// 6. FINANCIAL & INVOICE (MIDTRANS INTEGRATION & MOBILE SLICING)
// ==============================================================================

model Invoice {
  id             String          @id @default(cuid())
  externalId     String?         @unique // Idempotency: "INV-{leaseId}-{YYYY-MM}"
  dueDate        DateTime
  amount         Int             // Total net akhir (dikirim ke payment gateway)

  rentAmount     Int             @default(0)
  utilityAmount  Int             @default(0) // Listrik / Air
  otherAmount    Int             @default(0) // Iuran Sampah & Keamanan Lingkungan (Rp 28.000)

  // Split Fee Payment Gateway 50/50
  totalAdminFee  Int             @default(0) // Total fee PG (misal Rp 4.000)
  tenantAdminFee Int             @default(0) // Porsi beban tenant (misal Rp 2.000)
  ownerAdminFee  Int             @default(0) // Porsi diserap owner (misal Rp 2.000)

  // Diskon / Promo (Google Review, Early Bird)
  discountAmount Int             @default(0)
  discountReason String?

  status         PaymentStatus   @default(UNPAID)
  provider       PaymentProvider @default(MANUAL)
  providerRef    String?         // transaction_id dari Midtrans
  paymentUrl     String?         // Redirect URL Snap
  snapToken      String?         // Token Midtrans Snap

  // [Mobile UI: InvoicePayScreen & InvoiceDetailScreen]
  vaNumber       String?         // Nomor Virtual Account interaktif (ada tombol Salin di mobile)
  paymentMethod  String?         // Kode metode pembayaran, e.g. "BCA_VA", "QRIS"
  qrString       String?         // Raw payload QRIS untuk di-render langsung di mobile UI
  receiptPdfUrl  String?         // [Mobile UI: Tombol "Unduh Kuitansi Digital (PDF)"]

  paidAt         DateTime?
  expiredAt      DateTime?
  proofUrl       String?         // Foto bukti transfer manual di Cloudinary
  adminNote      String?         // Alasan penolakan / catatan persetujuan Owner

  // [Audit Jejak Verifikasi Manual Tier Starter]
  verifiedBy     String?         // ID User (Owner/Admin) yang menyetujui / menolak
  verifiedAt     DateTime?       // Waktu disetujui / ditolak

  // [Strict Multi-Tenant Scoping]
  propertyId     String?
  property       Property?       @relation(fields: [propertyId], references: [id])

  leaseId        String
  lease          Lease           @relation(fields: [leaseId], references: [id])

  webhookLogs    WebhookLog[]
  discountClaims DiscountClaim[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  @@index([propertyId])
  @@index([leaseId])
  @@index([status])
}

// ==============================================================================
// 7. MAINTENANCE TICKETS & REPORTS (15 SUB-WIDGETS FLUTTER ALIGNMENT)
// ==============================================================================

model Report {
  id             String       @id @default(cuid())
  title          String
  description    String       @db.Text
  status         ReportStatus @default(OPEN)

  // [Mobile UI: ReportNewScreen Form Inputs]
  category       String       @default("Kamar Mandi") // 'Kamar Mandi', 'Perabot & Kasur', 'Kelistrikan / Lampu', 'AC & Elektronik'
  location       String?      // e.g. "Kran shower sudut kiri", "Dekat Jendela"
  preferredTime  String?      // 'pagi' (09:00 - 12:00), 'siang' (13:00 - 16:00), 'bebas'
  photos         String[]     // [Mobile UI: Maks. 3 Foto WebP <= 500KB di Supabase]
  photoUrl       String?      // Backward compatibility

  // [Mobile UI: ReportDetailScreen & Sub-Widgets Pelacakan Teknisi]
  scheduledAt    DateTime?
  scheduleLabel  String?      // e.g. "Kunjungan Hari Ini • Pukul 10:30 WIB"
  progress       Float        @default(0.0) // 0.0 sampai 1.0 (ScheduleProgressTile)
  resolvedByName String?      // e.g. "Pak Slamet (Maintenance)"
  resolutionNote String?      @db.Text      // Catatan teknisi (ResolutionNoteTile)

  // [Strict Multi-Tenant Scoping]
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id])

  leaseId        String
  lease          Lease        @relation(fields: [leaseId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([propertyId])
  @@index([leaseId])
  @@index([status])
}

// ==============================================================================
// 8. NOTIFICATION & PUSH MESSAGING
// ==============================================================================

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String   @db.Text
  type        String   @default("INFO") // BILLING, MAINTENANCE, SYSTEM, INFO
  isRead      Boolean  @default(false)

  // [Mobile UI: NotificationsScreen Categories, Tags & Routing]
  category    String   @default("all")  // 'all', 'penting', 'tagihan', 'pemeliharaan'
  tag         String?  // e.g. "Penting Gedung", "Terverifikasi • Sewa", "Tiket #QNTMH4"
  extraNote   String?  // e.g. "Catatan Pengelola: Bagi kamar yang butuh galon tambahan..."
  actionLabel String?  // e.g. "Lihat Rincian Tagihan"
  actionUrl   String?  // e.g. "/invoices/INV-xxx"

  // [Strict Multi-Tenant Scoping]
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([isRead])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String

  // [Mobile FCM Support]
  platform  String   @default("web") // 'web', 'android', 'ios'
  deviceId  String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==============================================================================
// 9. SUPPORTING CONFIGURATIONS & AUDIT LOGS
// ==============================================================================

model PanoramaImage {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String   // URL publik dari Supabase (Oskost-Data-Public)
  storagePath String   // Path di bucket

  userId      String
  user        User     @relation(fields: [userId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([roomId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PaymentMethod {
  id                  String   @id @default(cuid())
  methodCode          String   @unique // e.g., "QRIS", "BCA_VA", "MANDIRI_VA"
  methodName          String   // e.g., "QRIS", "BCA Virtual Account"
  feeType             String   // "PERCENTAGE" atau "FLAT"
  feeAmount           Int      // Rupiah (flat) atau basis poin
  tenantFeePercentage Int      @default(50)
  ownerFeePercentage  Int      @default(50)
  isActive            Boolean  @default(true)

  // [Mobile UI: PaymentMethodTile & Accordion Data-Driven]
  subtitle            String?  // e.g. "Verifikasi Otomatis < 1 Menit"
  badgeText           String?  // e.g. "Otomatis", "Instan", "Populer"
  iconUrl             String?
  instructions        Json?    // Panduan transfer: [{ title: "ATM BCA", steps: [...] }]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WebhookLog {
  id             String          @id @default(cuid())
  invoiceId      String?
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  provider       PaymentProvider
  rawPayload     Json
  signatureValid Boolean         @default(false)
  httpStatusSent Int?
  createdAt      DateTime        @default(now())

  @@index([provider, createdAt])
}

model DiscountPreset {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "GOOGLE_REVIEW", "EARLY_BIRD"
  label       String   // e.g., "Bebas Biaya Admin (Google Review)"
  description String?
  type        String   // "FIXED" atau "ADMIN_FEE_WAIVER"
  amount      Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DiscountClaim {
  id           String      @id @default(cuid())
  invoiceId    String
  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountCode String
  proofUrl     String      // Foto screenshot ulasan Google Maps di Supabase
  googleName   String?
  status       ClaimStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  @@index([status])
  @@index([invoiceId])
  @@index([userId])
}

// ==============================================================================
// 10. AUDIT LOGGING & PLATFORM SECURITY
// ==============================================================================

enum AuditCategory {
  AUTH
  SUBSCRIPTION
  OWNER
  SYSTEM
  PROPERTY
  SECURITY
}

model AuditLog {
  id          String        @id @default(cuid())
  actorId     String?       // ID User yang mengeksekusi aksi
  actorEmail  String?       // Snapshot email user saat aksi
  actorRole   UserRole?     // Role saat aksi
  action      String        // e.g. "SUPER_ADMIN_LOGIN", "OWNER_SUSPENDED", "PLAN_CHANGED"
  category    AuditCategory @default(SYSTEM)
  targetType  String?       // "User", "Property", "SaaSSubscription", "Invoice"
  targetId    String?       // ID entitas target
  metadata    Json?         // Snapshot detail (oldValue, newValue, params)
  ipAddress   String?       // IP Address client
  userAgent   String?       // Device info
  createdAt   DateTime      @default(now())

  @@index([actorId])
  @@index([category])
  @@index([action])
  @@index([createdAt])
}

// ==============================================================================
// 11. SAAS PRICING PLANS & FEATURE MATRIX
// ==============================================================================

model SaaSPlan {
  id             String       @id @default(cuid())
  tier           SaaSPlanTier @unique // FREE, STARTER, GROWTH, PRO, ENTERPRISE
  name           String       // "Starter Plan", "Pro Scale", dll.
  description    String?      @db.Text
  monthlyPrice   Int          // Harga per bulan (Rp)
  annualPrice    Int          // Harga per tahun jika bayar tahunan (Rp)
  maxRooms       Int          // Batas maksimal unit kamar
  maxProperties  Int          @default(1)
  features       Json         // { "smartLock": false, "customDomain": false, "midtransGateway": true, dll }
  isActive       Boolean      @default(true)
  isPopular      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ==============================================================================
// 12. SAAS B2B SUBSCRIPTION TRANSACTIONS
// ==============================================================================

model SaaSTransaction {
  id                String            @id @default(cuid())
  subscriptionId    String
  subscription      SaaSSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amount            Int               // Nominal tagihan (Rp)
  periodMonths      Int               @default(1) // 1 bulan / 12 bulan
  planTier          SaaSPlanTier
  status            PaymentStatus     @default(PENDING) // PENDING, PAID, FAILED, EXPIRED
  paymentMethod     String?           // "QRIS", "BCA_VA", "MANDIRI_VA", "MANUAL"
  midtransOrderId   String?           @unique
  midtransSnapToken String?
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([subscriptionId])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
}

